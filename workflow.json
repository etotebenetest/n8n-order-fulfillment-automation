    {
      "parameters": {
        "jsCode": "const warehouses = [\n  {\n    warehouse: \"Москва\",\n    city: \"Москва\",\n    iphoneQty: 5,\n    airpodsQty: 0,\n    watchQty: 4\n  },\n  {\n    warehouse: \"Казань\",\n    city: \"Казань\",\n    iphoneQty: 3,\n    airpodsQty: 5,\n    watchQty: 1\n  },\n  {\n    warehouse: \"Новосибирск\",\n    city: \"Новосибирск\",\n    iphoneQty: 8,\n    airpodsQty: 8,\n    watchQty: 8\n  }\n];\n\nreturn [\n  {\n    json: {\n      ...$input.first().json,\n      warehouses\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        -16
      ],
      "id": "8420e32e-ecce-4047-b0c5-ea9a5821d426",
      "name": "Load Warehouse Stock"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst orderItems = $(\"Receive Order\").first().json.body.items;\n\nconst localWarehouses = data.warehouses.filter(\n    warehouse => warehouse.city === data.City\n);\n\nlet suitableWarehouse = localWarehouses.find(\n    warehouse =>\n        orderItems.every(\n            item => warehouse[item.key] >= item.qty\n        )\n);\n\n// Если локальный склад не подходит,\n// ищем склад среди всех городов\nif (!suitableWarehouse) {\n    suitableWarehouse = data.warehouses.find(\n        warehouse =>\n            orderItems.every(\n                item => warehouse[item.key] >= item.qty\n            )\n    );\n}\n\nconst remainingItems = orderItems.map(item => ({\n    ...item\n}));\n\nlet allocations = [];\n\nif (suitableWarehouse) {\n    allocations = [\n        {\n            warehouse: suitableWarehouse.warehouse,\n            allocatedItems: orderItems.map(item => ({\n                product: item.product,\n                qty: item.qty\n            }))\n        }\n        ];\n\n    remainingItems.forEach(item => {\n        item.qty = 0;\n    });\n\n} else {\n    allocations = data.warehouses.map(warehouse => {\n        const allocatedItems = remainingItems\n            .filter(\n                item =>\n                    item.qty > 0 &&\n                    warehouse[item.key] > 0\n            )\n            .map(item => {\n                const allocatedQty = Math.min(\n                    warehouse[item.key],\n                    item.qty\n                );\n\n                item.qty = item.qty - allocatedQty;\n\n                return {\n                    product: item.product,\n                    qty: allocatedQty\n                };\n            });\n\n        return {\n            warehouse: warehouse.warehouse,\n            allocatedItems\n        };\n    });\n}\n\nconst activeWarehouses = allocations.filter(\n    allocation => allocation.allocatedItems.length > 0\n);\n\nconst allItemsAllocated =\n    Boolean(suitableWarehouse) ||\n    remainingItems.every(item => item.qty === 0);\n\nconst warehousesText = activeWarehouses\n    .map(allocation => allocation.warehouse)\n    .join(\" → \");\n\nconst missingItems = remainingItems.filter(item => item.qty > 0);\n\nreturn activeWarehouses.map(allocation => {\n    return {\n        json: {\n            orderId: $(\"Receive Order\").first().json.body.orderId,\n            warehousesText,\n            warehouse: allocation.warehouse,\n            allItemsAllocated,\n            missingItems,\n            message: `📦 Новый заказ для склада: ${allocation.warehouse}\n\n${allocation.allocatedItems\n    .map(item => `• ${item.product} - ${item.qty} шт.`)\n    .join(\"\\n\")}`\n        }\n    };\n});"
      },
