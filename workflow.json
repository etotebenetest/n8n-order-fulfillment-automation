    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [];\n}\n\nconst data = items[0].json;\n\nconst missingItems = data.missingItems || [];\n\nlet message = `❌ Заказ №${data.orderId} невозможно собрать полностью.\\n\\n`;\n\nif (missingItems.length > 0) {\n  message += `Не хватает:\\n`;\n\n  for (const item of missingItems) {\n    message += `• ${item.product} — ${item.qty} шт.\\n`;\n  }\n} else {\n  message += `Недостаточно товара на складах.`;\n}\n\nreturn [\n  {\n    json: {\n      orderId: data.orderId,\n      status: \"OUT_OF_STOCK\",\n      missingItems,\n      message\n    }\n  }\n];"
      },
